---

---

<div id="raven-flock" class="raven-flock" aria-hidden="true"></div>

<style is:global>
	.raven-flock {
		position: fixed;
		inset: 0;
		z-index: 65;
		pointer-events: none;
		overflow: hidden;
	}

	.raven-bird {
		position: absolute;
		left: 0;
		top: 0;
		width: 6rem;
		height: 4.5rem;
		pointer-events: none;
		user-select: none;
		will-change: transform;
		filter:
			drop-shadow(0 0.55rem 0.85rem rgb(3 7 18 / 0.24))
			hue-rotate(var(--bird-hue-rotate, 0deg))
			saturate(var(--bird-saturate, 1))
			brightness(var(--bird-brightness, 1));
		transform-origin: 50% 88%;
	}

	.raven-bird::after {
		content: "";
		position: absolute;
		left: 50%;
		bottom: 0.18rem;
		width: 2.7rem;
		height: 0.22rem;
		border-radius: 999px;
		background:
			linear-gradient(
				90deg,
				rgba(226, 232, 240, 0.04),
				rgba(226, 232, 240, 0.32),
				rgba(226, 232, 240, 0.04)
			);
		transform: translate3d(-50%, 0, 0) scaleX(var(--bird-perch-scale, 0.9));
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.raven-bird[data-state="perched"]::after {
		opacity: 0.85;
	}

	.raven-bird__sprite,
	.raven-bird__sprite svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		image-rendering: pixelated;
	}

	.raven-bird__sprite {
		transform:
			translate3d(var(--bird-body-shift-x, 0px), var(--bird-body-bob, 0px), 0)
			rotate(var(--bird-body-tilt, 0deg));
		transform-origin: 50% 88%;
		will-change: transform;
	}
</style>

<script is:inline>
	(() => {
		const CONTROLLER_KEY = "__alfRavenFlockController";
		const BOUND_KEY = "__alfRavenFlockBound";
		const SPRITE_WIDTH = 24;
		const SPRITE_HEIGHT = 18;
		const BIRD_WIDTH = 96;
		const BIRD_HEIGHT = 72;
		const FOOT_OFFSET = 58;
		const MAX_BIRD_COUNT = 10;
		const FLIGHT_SEQUENCE = [1, 2, 3, 4, 5, 4, 3, 2];
		const PERCH_PROGRAMS = [
			[0, 0, 2, 0, 0, 3, 0, 0],
			[0, 5, 0, 0, 2, 0, 0, 0],
			[0, 0, 3, 0, 5, 0, 0, 0],
			[2, 0, 0, 5, 0, 0, 3, 0],
			[0, 3, 0, 2, 0, 0, 5, 0],
			[5, 0, 2, 0, 3, 0, 0, 0],
		];

		const palette = {
			body: "#17181d",
			shadow: "#09090c",
			highlight: "#2b2e36",
			beak: "#b69357",
			eye: "#f1ead3",
		};

		const frameDefinitions = [
			[
				[7, 6, 7, 1, "highlight"],
				[8, 7, 9, 4, "body"],
				[10, 8, 7, 3, "shadow"],
				[15, 5, 3, 2, "body"],
				[17, 4, 3, 3, "body"],
				[18, 5, 2, 2, "shadow"],
				[20, 5, 2, 1, "beak"],
				[4, 9, 4, 2, "shadow"],
				[3, 10, 2, 1, "body"],
				[11, 11, 1, 3, "shadow"],
				[14, 11, 1, 3, "shadow"],
				[10, 14, 3, 1, "shadow"],
				[13, 14, 3, 1, "shadow"],
				[19, 5, 1, 1, "eye"],
			],
			[
				[7, 9, 8, 3, "body"],
				[9, 10, 6, 2, "shadow"],
				[14, 7, 3, 2, "body"],
				[17, 6, 3, 3, "body"],
				[18, 7, 2, 2, "shadow"],
				[20, 7, 2, 1, "beak"],
				[4, 8, 3, 2, "shadow"],
				[2, 7, 3, 1, "highlight"],
				[10, 6, 4, 2, "body"],
				[12, 4, 3, 3, "body"],
				[11, 5, 2, 4, "shadow"],
				[10, 12, 2, 2, "shadow"],
				[13, 12, 2, 2, "shadow"],
				[19, 7, 1, 1, "eye"],
			],
			[
				[7, 7, 6, 1, "highlight"],
				[7, 8, 7, 4, "body"],
				[9, 9, 6, 3, "shadow"],
				[14, 6, 3, 2, "body"],
				[17, 5, 3, 3, "body"],
				[18, 6, 2, 2, "shadow"],
				[20, 6, 2, 1, "beak"],
				[3, 9, 4, 4, "body"],
				[2, 10, 2, 3, "shadow"],
				[14, 8, 6, 5, "body"],
				[16, 9, 4, 4, "shadow"],
				[5, 8, 2, 1, "highlight"],
				[8, 12, 2, 1, "shadow"],
				[12, 12, 2, 1, "shadow"],
				[19, 6, 1, 1, "eye"],
			],
			[
				[7, 7, 6, 1, "highlight"],
				[7, 8, 7, 4, "body"],
				[9, 9, 6, 3, "shadow"],
				[14, 6, 3, 2, "body"],
				[17, 5, 3, 3, "body"],
				[18, 6, 2, 2, "shadow"],
				[20, 6, 2, 1, "beak"],
				[1, 7, 6, 3, "body"],
				[0, 8, 4, 2, "shadow"],
				[14, 6, 8, 4, "body"],
				[18, 7, 4, 3, "shadow"],
				[5, 6, 2, 1, "highlight"],
				[19, 6, 1, 1, "eye"],
			],
			[
				[8, 8, 7, 3, "body"],
				[10, 9, 5, 2, "shadow"],
				[15, 6, 3, 2, "body"],
				[18, 5, 3, 3, "body"],
				[19, 6, 2, 2, "shadow"],
				[21, 6, 2, 1, "beak"],
				[7, 1, 3, 7, "body"],
				[6, 2, 2, 6, "shadow"],
				[14, 0, 4, 8, "body"],
				[16, 1, 2, 7, "shadow"],
				[4, 9, 4, 2, "shadow"],
				[3, 10, 2, 1, "body"],
				[19, 6, 1, 1, "eye"],
			],
			[
				[8, 7, 8, 4, "body"],
				[10, 8, 6, 3, "shadow"],
				[16, 5, 3, 3, "body"],
				[19, 6, 2, 2, "shadow"],
				[21, 6, 2, 1, "beak"],
				[6, 5, 10, 2, "highlight"],
				[2, 7, 6, 2, "body"],
				[1, 8, 4, 2, "shadow"],
				[16, 6, 6, 2, "body"],
				[18, 7, 4, 2, "shadow"],
				[4, 9, 4, 1, "shadow"],
				[3, 10, 2, 1, "body"],
				[18, 6, 1, 1, "eye"],
			],
		];

		const buildSpriteMarkup = (rects) => {
			const spriteRects = rects
				.map(
					([x, y, width, height, color]) =>
						`<rect x="${x}" y="${y}" width="${width}" height="${height}" fill="${palette[color]}" />`,
				)
				.join("");

			return `<svg viewBox="0 0 ${SPRITE_WIDTH} ${SPRITE_HEIGHT}" role="presentation" focusable="false" shape-rendering="crispEdges">${spriteRects}</svg>`;
		};

		const spriteMarkup = frameDefinitions.map(buildSpriteMarkup);
		const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
		const lerp = (start, end, progress) => start + (end - start) * progress;
		const easeInOutSine = (value) => -(Math.cos(Math.PI * value) - 1) / 2;
		const distanceBetween = (left, right) =>
			Math.hypot(left.x - right.x, left.y - right.y);
		const quadraticPoint = (start, control, end, progress) => {
			const inverse = 1 - progress;
			return {
				x:
					inverse * inverse * start.x +
					2 * inverse * progress * control.x +
					progress * progress * end.x,
				y:
					inverse * inverse * start.y +
					2 * inverse * progress * control.y +
					progress * progress * end.y,
			};
		};

		const mulberry32 = (seed) => {
			let current = seed >>> 0;
			return () => {
				current |= 0;
				current = (current + 0x6d2b79f5) | 0;
				let next = Math.imul(current ^ (current >>> 15), 1 | current);
				next ^= next + Math.imul(next ^ (next >>> 7), 61 | next);
				return ((next ^ (next >>> 14)) >>> 0) / 4294967296;
			};
		};

		const randomBetween = (rng, min, max) => min + rng() * (max - min);
		const chooseFromTop = (items, count, rng) => {
			if (items.length <= count) {
				return items[Math.floor(rng() * items.length)] ?? null;
			}

			const limit = Math.max(1, count);
			return items[Math.floor(rng() * limit)] ?? null;
		};

		const setBirdFrame = (bird, frameIndex) => {
			if (bird.frameIndex === frameIndex) {
				return;
			}

			bird.frameIndex = frameIndex;
			bird.sprite.innerHTML = spriteMarkup[frameIndex] ?? spriteMarkup[0];
		};

		const createBird = (index) => {
			const rng = mulberry32((0x9e3779b9 ^ ((index + 1) * 2654435761)) >>> 0);
			const element = document.createElement("div");
			element.className = "raven-bird";
			element.dataset.state = "perched";

			const sprite = document.createElement("div");
			sprite.className = "raven-bird__sprite";
			element.appendChild(sprite);

			const bird = {
				id: index,
				rng,
				element,
				sprite,
				frameIndex: -1,
				state: "perched",
				scale: randomBetween(rng, 0.92, 1.12),
				hueRotate: randomBetween(rng, -5, 7),
				saturate: randomBetween(rng, 0.92, 1.08),
				brightness: randomBetween(rng, 0.88, 1.04),
				perchScale: randomBetween(rng, 0.82, 1.08),
				bobAmplitude: 0.7 + index * 0.24 + randomBetween(rng, 0.05, 0.35),
				bobFrequency: 0.72 + index * 0.1 + randomBetween(rng, 0.02, 0.12),
				bodyShiftAmplitude: 0.18 + index * 0.06 + randomBetween(rng, 0.04, 0.12),
				tiltAmplitude: 1.1 + index * 0.28 + randomBetween(rng, 0.08, 0.32),
				tiltFrequency: 0.64 + index * 0.09 + randomBetween(rng, 0.03, 0.14),
				flapInterval: 54 + index * 8 + Math.round(randomBetween(rng, 0, 9)),
				flightSpeed: 178 + index * 14 + randomBetween(rng, 0, 22),
				arcLift: 92 + index * 16 + randomBetween(rng, 6, 24),
				arcBias: randomBetween(rng, -58, 58),
				lanePreference: randomBetween(rng, 0.12, 0.88),
				altitudePreference: randomBetween(rng, 0.18, 0.7),
				restBaseMs: 2500 + index * 380 + Math.round(randomBetween(rng, 120, 640)),
				restJitterMs: 420 + index * 90 + Math.round(randomBetween(rng, 90, 360)),
				poseOffsetMs: Math.round(randomBetween(rng, 0, 4000)),
				poseIntervalMs: 440 + index * 65 + Math.round(randomBetween(rng, 35, 130)),
				initialDelayMs: 1100 + index * 820 + Math.round(randomBetween(rng, 120, 520)),
				flightPhase: randomBetween(rng, 0, Math.PI * 2),
				perchFacing: rng() > 0.5 ? 1 : -1,
				centerX: 0,
				footY: 0,
				start: { x: 0, y: 0 },
				control: { x: 0, y: 0 },
				destination: { x: 0, y: 0 },
				perchUntil: 0,
				flightStartedAt: 0,
				flightDurationMs: 0,
				currentPerch: null,
				targetPerch: null,
				poseProgram: PERCH_PROGRAMS[index % PERCH_PROGRAMS.length],
			};

			element.style.setProperty("--bird-hue-rotate", `${bird.hueRotate.toFixed(2)}deg`);
			element.style.setProperty("--bird-saturate", bird.saturate.toFixed(3));
			element.style.setProperty("--bird-brightness", bird.brightness.toFixed(3));
			element.style.setProperty("--bird-perch-scale", bird.perchScale.toFixed(3));
			setBirdFrame(bird, 0);
			return bird;
		};

		const createController = () => {
			const controller = {
				root: null,
				birds: [],
				perches: [],
				viewportWidth: window.innerWidth,
				viewportHeight: window.innerHeight,
				rafId: 0,
				lastTickAt: performance.now(),
				lastRefreshAt: 0,
				syncRoot(root) {
					if (!(root instanceof HTMLElement)) {
						this.root = null;
						return;
					}

					if (this.root === root) {
						return;
					}

					this.root = root;
					this.root.replaceChildren();
					this.birds.forEach((bird) => {
						this.root.appendChild(bird.element);
					});
				},
				getDesiredBirdCount() {
					if (this.viewportWidth < 640) {
						return 4;
					}

					if (this.viewportWidth < 1100) {
						return 5;
					}

					return 6;
				},
				ensureBirdPopulation() {
					const desiredCount = this.getDesiredBirdCount();

					while (this.birds.length < desiredCount) {
						const bird = createBird(this.birds.length);
						this.birds.push(bird);
						if (this.root) {
							this.root.appendChild(bird.element);
						}
					}

					while (this.birds.length > desiredCount) {
						const bird = this.birds.pop();
						bird?.element.remove();
					}
				},
				buildPerches() {
					const safeMarginX = clamp(this.viewportWidth * 0.08, 42, 92);
					const safeTop = clamp(this.viewportHeight * 0.12, 86, 138);
					const safeBottom = clamp(this.viewportHeight * 0.16, 112, 170);
					const maxY = this.viewportHeight - safeBottom;
					const rows = [
						{
							y: clamp(this.viewportHeight * 0.18, safeTop, safeTop + 22),
							xs: [0.13, 0.29, 0.48, 0.67, 0.86],
						},
						{
							y: clamp(this.viewportHeight * 0.31, safeTop + 44, safeTop + 118),
							xs: [0.18, 0.38, 0.6, 0.82],
						},
						{
							y: clamp(this.viewportHeight * 0.48, safeTop + 110, maxY - 80),
							xs: [0.14, 0.34, 0.56, 0.78],
						},
						{
							y: clamp(this.viewportHeight * 0.66, safeTop + 180, maxY),
							xs: [0.24, 0.48, 0.72],
						},
					];

					this.perches = rows.flatMap((row, rowIndex) =>
						row.xs.map((fraction, columnIndex) => ({
							key: `row-${rowIndex}-col-${columnIndex}`,
							x: clamp(this.viewportWidth * fraction, safeMarginX, this.viewportWidth - safeMarginX),
							y: row.y,
						})),
					);
				},
				pickPerchForBird(bird, options = {}) {
					const avoidKeys = options.avoidKeys ?? new Set();
					const reservedKeys = new Set(
						this.birds
							.filter((otherBird) => otherBird !== bird)
							.flatMap((otherBird) => [
								otherBird.currentPerch?.key ?? null,
								otherBird.targetPerch?.key ?? null,
							])
							.filter(Boolean),
					);

					const sourcePoint =
						Number.isFinite(bird.centerX) && Number.isFinite(bird.footY)
							? { x: bird.centerX, y: bird.footY }
							: { x: this.viewportWidth * bird.lanePreference, y: this.viewportHeight * bird.altitudePreference };

					const rankedPerches = this.perches
						.filter((perch) => perch.key !== bird.currentPerch?.key)
						.map((perch) => {
							const normalizedX = perch.x / Math.max(1, this.viewportWidth);
							const normalizedY = perch.y / Math.max(1, this.viewportHeight);
							const laneScore = 1 - Math.abs(normalizedX - bird.lanePreference);
							const altitudeScore = 1 - Math.abs(normalizedY - bird.altitudePreference);
							const distance = distanceBetween(sourcePoint, perch);
							const distanceScore = clamp(distance / Math.max(180, this.viewportWidth * 0.42), 0, 1);
							const avoidPenalty = avoidKeys.has(perch.key) ? 0.42 : 0;
							const reservedPenalty = reservedKeys.has(perch.key) ? 0.25 : 0;
							const edgePenalty =
								Math.abs(normalizedX - 0.5) > 0.36 ? 0.08 : 0;
							return {
								perch,
								score:
									laneScore * 0.34 +
									altitudeScore * 0.18 +
									distanceScore * 0.38 -
									avoidPenalty -
									reservedPenalty -
									edgePenalty,
							};
						})
						.sort((left, right) => right.score - left.score);

					return chooseFromTop(
						rankedPerches.map((item) => item.perch),
						3,
						bird.rng,
					);
				},
				assignPerch(bird, perch, now, options = {}) {
					bird.state = "perched";
					bird.element.dataset.state = "perched";
					bird.currentPerch = perch;
					bird.targetPerch = null;
					bird.centerX = perch.x;
					bird.footY = perch.y;
					if (!options.keepFacing) {
						const shouldFaceRight =
							perch.x < this.viewportWidth * 0.42
								? true
								: perch.x > this.viewportWidth * 0.58
									? false
									: bird.perchFacing > 0;
						bird.perchFacing = shouldFaceRight ? 1 : -1;
					}
					bird.perchUntil =
						now +
						bird.restBaseMs +
						randomBetween(bird.rng, 0, bird.restJitterMs) +
						bird.id * 70;
				},
				placeBirdsOnPerches(now) {
					const claimedPerches = new Set();
					this.birds.forEach((bird) => {
						const perch =
							this.pickPerchForBird(bird, { avoidKeys: claimedPerches }) ??
							this.perches[(bird.id * 2) % this.perches.length] ??
							this.perches[0];
						if (!perch) {
							return;
						}

						claimedPerches.add(perch.key);
						this.assignPerch(bird, perch, now, { keepFacing: false });
						bird.perchUntil = now + bird.initialDelayMs;
					});
				},
				refreshLayout(forceReposition = false) {
					this.viewportWidth = window.innerWidth;
					this.viewportHeight = window.innerHeight;
					this.ensureBirdPopulation();
					this.buildPerches();
					const now = performance.now();

					if (forceReposition || this.lastRefreshAt === 0) {
						this.placeBirdsOnPerches(now);
					} else {
						this.birds.forEach((bird) => {
							if (bird.state === "perched") {
								const nearestPerch =
									this.pickPerchForBird(bird) ??
									this.perches[bird.id % this.perches.length];
								if (nearestPerch) {
									this.assignPerch(bird, nearestPerch, now, { keepFacing: true });
								}
							} else {
								bird.centerX = clamp(
									bird.centerX,
									BIRD_WIDTH * 0.5,
									this.viewportWidth - BIRD_WIDTH * 0.5,
								);
								bird.footY = clamp(
									bird.footY,
									FOOT_OFFSET + 12,
									this.viewportHeight - 56,
								);
								bird.destination.x = clamp(
									bird.destination.x,
									BIRD_WIDTH * 0.5,
									this.viewportWidth - BIRD_WIDTH * 0.5,
								);
								bird.destination.y = clamp(
									bird.destination.y,
									FOOT_OFFSET + 12,
									this.viewportHeight - 56,
								);
							}
						});
					}

					this.lastRefreshAt = now;
				},
				startFlight(bird, now) {
					const targetPerch = this.pickPerchForBird(bird);
					if (!targetPerch) {
						bird.perchUntil = now + 1200;
						return;
					}

					bird.state = "flying";
					bird.element.dataset.state = "flying";
					bird.targetPerch = targetPerch;
					bird.start = { x: bird.centerX, y: bird.footY };
					bird.destination = { x: targetPerch.x, y: targetPerch.y };
					const direction = targetPerch.x >= bird.centerX ? 1 : -1;
					const distance = distanceBetween(bird.start, bird.destination);
					const curveLift =
						bird.arcLift + clamp(distance * 0.14, 0, 88) + randomBetween(bird.rng, 0, 24);
					bird.control = {
						x: clamp(
							lerp(bird.start.x, bird.destination.x, 0.5) +
								bird.arcBias * direction * (0.42 + bird.rng() * 0.4),
							BIRD_WIDTH * 0.5,
							this.viewportWidth - BIRD_WIDTH * 0.5,
						),
						y: clamp(
							Math.min(bird.start.y, bird.destination.y) - curveLift,
							FOOT_OFFSET + 8,
							this.viewportHeight - 180,
						),
					};
					bird.flightStartedAt = now;
					bird.flightDurationMs = clamp(
						(distance / bird.flightSpeed) * 1000,
						1050,
						2550,
					);
					bird.perchFacing = direction;
				},
				updateBird(bird, now) {
					if (bird.state === "perched") {
						if (now >= bird.perchUntil) {
							this.startFlight(bird, now);
						}
						return;
					}

					const rawProgress = clamp(
						(now - bird.flightStartedAt) / Math.max(1, bird.flightDurationMs),
						0,
						1,
					);
					const progress = easeInOutSine(rawProgress);
					const point = quadraticPoint(
						bird.start,
						bird.control,
						bird.destination,
						progress,
					);
					bird.centerX = point.x;
					bird.footY = point.y;

					if (rawProgress >= 1) {
						this.assignPerch(bird, bird.targetPerch, now, { keepFacing: true });
					}
				},
				renderBird(bird, now) {
					let bodyBob = 0;
					let bodyShiftX = 0;
					let bodyTilt = 0;

					if (bird.state === "perched") {
						const poseIndex =
							Math.floor((now + bird.poseOffsetMs) / bird.poseIntervalMs) %
							bird.poseProgram.length;
						setBirdFrame(bird, bird.poseProgram[poseIndex] ?? 0);
						bodyBob =
							Math.sin(now * 0.001 * bird.bobFrequency + bird.flightPhase) *
							bird.bobAmplitude;
						bodyShiftX =
							Math.sin(now * 0.00082 * bird.tiltFrequency + bird.flightPhase * 0.8) *
							bird.bodyShiftAmplitude;
						bodyTilt =
							Math.sin(now * 0.00088 * bird.tiltFrequency + bird.flightPhase) *
							bird.tiltAmplitude;
					} else {
						const flightIndex =
							Math.floor((now + bird.poseOffsetMs) / bird.flapInterval) %
							FLIGHT_SEQUENCE.length;
						setBirdFrame(bird, FLIGHT_SEQUENCE[flightIndex] ?? 1);
						bodyBob =
							Math.sin(now * 0.0022 + bird.flightPhase) *
							(0.7 + bird.id * 0.08);
						bodyShiftX =
							Math.sin(now * 0.0017 + bird.flightPhase * 0.6) *
							(0.22 + bird.id * 0.03);
						bodyTilt =
							bird.perchFacing * (2.8 + bird.id * 0.16) +
							Math.sin(now * 0.0014 + bird.flightPhase) * 0.9;
					}

					bird.sprite.style.setProperty(
						"--bird-body-bob",
						`${bodyBob.toFixed(2)}px`,
					);
					bird.sprite.style.setProperty(
						"--bird-body-shift-x",
						`${bodyShiftX.toFixed(2)}px`,
					);
					bird.sprite.style.setProperty(
						"--bird-body-tilt",
						`${bodyTilt.toFixed(2)}deg`,
					);

					const x = bird.centerX - (BIRD_WIDTH * bird.scale) / 2;
					const y = bird.footY - FOOT_OFFSET * bird.scale;
					bird.element.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scaleX(${bird.perchFacing}) scale(${bird.scale.toFixed(3)})`;
				},
				getHeadHitboxes() {
					return this.birds.map((bird) => {
						const width = BIRD_WIDTH * bird.scale;
						const height = BIRD_HEIGHT * bird.scale;
						const x = bird.centerX - width / 2;
						const y = bird.footY - FOOT_OFFSET * bird.scale;
						const headWidth = width * 0.22;
						const headHeight = height * 0.2;
						const headX =
							bird.perchFacing > 0
								? x + width * 0.67
								: x + width * 0.11;
						const headY = y + height * 0.1;
						return {
							x: headX,
							y: headY,
							width: headWidth,
							height: headHeight,
						};
					});
				},
				getWeatherState() {
					return {
						birdCount: this.birds.length,
						maxBirdCount: MAX_BIRD_COUNT,
						foodDetected: false,
					};
				},
				tick(now) {
					this.birds.forEach((bird) => {
						this.updateBird(bird, now);
						this.renderBird(bird, now);
					});

					this.lastTickAt = now;
					this.rafId = window.requestAnimationFrame((nextNow) => this.tick(nextNow));
				},
				start() {
					if (this.rafId) {
						return;
					}

					this.lastTickAt = performance.now();
					this.rafId = window.requestAnimationFrame((now) => this.tick(now));
				},
			};

			return controller;
		};

		const controller =
			window[CONTROLLER_KEY] || (window[CONTROLLER_KEY] = createController());
		window.__alfRavenHeadHitboxes = () => controller.getHeadHitboxes();
		window.__alfRavenWeatherState = () => controller.getWeatherState();

		const mountRavenFlock = (forceReposition = false) => {
			controller.syncRoot(document.getElementById("raven-flock"));
			controller.refreshLayout(forceReposition);
			controller.start();
		};

		if (!window[BOUND_KEY]) {
			window.addEventListener(
				"resize",
				() => {
					mountRavenFlock(false);
				},
				{ passive: true },
			);
			document.addEventListener("astro:page-load", () => mountRavenFlock(true));
			document.addEventListener("DOMContentLoaded", () => mountRavenFlock(true));
			window[BOUND_KEY] = true;
		}

		mountRavenFlock(controller.birds.length === 0);
	})();
</script>
