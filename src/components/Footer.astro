---
import { profileConfig, siteConfig } from "../config";
import { getFirstContentPublishedAt } from "../utils/content-utils";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const SITE_TIMEZONE_OFFSET_MINUTES = 8 * 60;

const toRunningSinceTimestamp = (date: Date | null) => {
	if (!date) {
		return "";
	}

	const isDateOnlyEntry =
		date.getUTCHours() === 0 &&
		date.getUTCMinutes() === 0 &&
		date.getUTCSeconds() === 0 &&
		date.getUTCMilliseconds() === 0;

	if (!isDateOnlyEntry) {
		return String(date.getTime());
	}

	const [year, month, day] = date.toISOString().slice(0, 10).split("-").map(Number);
	return String(
		Date.UTC(year, month - 1, day, 0, 0, 0, 0) -
			SITE_TIMEZONE_OFFSET_MINUTES * 60 * 1000,
	);
};

const firstContentPublishedAt = await getFirstContentPublishedAt();
const runningSince = toRunningSinceTimestamp(firstContentPublishedAt);
const visitorCounterApi = siteConfig.footer?.visitorCounterApi ?? "";
---

<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<div class="footer-shell transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6 py-5">
	<div class="footer-status-grid">
		<div class="footer-status-chip">
			<span class="footer-status-label">值班乌鸦已值守</span>
			<strong id="footer-uptime" data-running-since={runningSince}>正在校准风向...</strong>
		</div>
		<div class="footer-status-chip">
			<span class="footer-status-label">羽毛落点累计</span>
			<strong id="footer-visits" data-counter-ready="false">正在清点脚印...</strong>
		</div>
	</div>

	<div class="transition text-50 text-sm text-center leading-7">
		&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. 保留所有权利 /
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url("rss.xml")}>RSS</a> /
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url("sitemap-index.xml")}>站点地图</a><br>
		由
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a>
		&
		<a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
		驱动
	</div>
</div>

<style>
	.footer-shell {
		gap: 1rem;
	}

	.footer-status-grid {
		width: min(100%, 42rem);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.footer-status-chip {
		display: grid;
		gap: 0.35rem;
		padding: 0.9rem 1rem;
		border-radius: 1rem;
		border: 1px solid var(--frame);
		background: transparent;
		box-shadow: var(--surface-shadow);
		backdrop-filter: blur(12px);
		text-align: left;
	}

	.footer-status-label {
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(71, 85, 105, 0.76);
	}

	.footer-status-chip strong {
		font-size: 0.96rem;
		font-weight: 800;
		color: rgba(15, 23, 42, 0.92);
	}

	:global(.dark) .footer-status-label {
		color: rgba(203, 213, 225, 0.62);
	}

	:global(.dark) .footer-status-chip strong {
		color: rgba(248, 250, 252, 0.92);
	}

	@media (max-width: 900px) {
		.footer-status-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.footer-shell {
			padding-left: 1rem;
			padding-right: 1rem;
		}
	}
</style>

<script is:inline define:vars={{ visitorCounterApi }}>
	const VISITOR_COUNTER_BOUND_KEY = "__alfFooterVisitorCounterBound";
	const VISITOR_IDENTITY_STORAGE_KEY = "bsz-id";
	const footerWindow = window;
	const footerState =
		footerWindow.__alfFooterVisitorCounterState ||
		(footerWindow.__alfFooterVisitorCounterState = {
			uptimeTimer: 0,
			requestToken: 0,
			activePageKey: "",
			pendingPageKey: "",
			lastCountsByPageKey: {},
		});
	const counterApi =
		typeof visitorCounterApi === "string"
			? visitorCounterApi.replace(/\/js(?:[?#].*)?$/, "/api")
			: "";

	const formatDuration = (ms) => {
		const totalMinutes = Math.max(0, Math.floor(ms / 60000));
		const days = Math.floor(totalMinutes / 1440);
		const hours = Math.floor((totalMinutes % 1440) / 60);
		const minutes = totalMinutes % 60;

		if (days > 0) {
			return `${days} 天 ${hours} 小时 ${minutes} 分钟`;
		}

		if (hours > 0) {
			return `${hours} 小时 ${minutes} 分钟`;
		}

		return `${minutes} 分钟`;
	};

	const normalizeVisitCount = (value) => {
		if (typeof value === "number" && Number.isFinite(value)) {
			return Math.max(0, Math.floor(value));
		}

		if (typeof value === "string") {
			const parsedValue = Number.parseInt(value.replace(/[^\d]/g, ""), 10);
			if (Number.isFinite(parsedValue)) {
				return Math.max(0, parsedValue);
			}
		}

		return null;
	};

	const formatVisits = (count) =>
		new Intl.NumberFormat("zh-CN").format(Math.max(0, count));

	const syncFooterUptime = () => {
		const uptimeNode = document.getElementById("footer-uptime");
		if (!(uptimeNode instanceof HTMLElement)) {
			return;
		}

		const runningSince = uptimeNode.dataset.runningSince;
		const parsedTimestamp = runningSince
			? Number.parseInt(runningSince, 10)
			: Number.NaN;
		const startedAt = Number.isFinite(parsedTimestamp)
			? parsedTimestamp
			: runningSince
				? new Date(runningSince).getTime()
				: Number.NaN;
		uptimeNode.textContent = Number.isFinite(startedAt)
			? formatDuration(Date.now() - startedAt)
			: "时间戳失联";
	};

	const renderFooterVisits = (value, fallback = false) => {
		const visitsNode = document.getElementById("footer-visits");
		if (!(visitsNode instanceof HTMLElement)) {
			return;
		}

		if (typeof value === "number" && Number.isFinite(value) && value >= 0) {
			visitsNode.dataset.counterReady = "true";
			visitsNode.textContent = `${formatVisits(value)} 次来回盘旋`;
			return;
		}

		if (fallback && visitsNode.dataset.counterReady !== "true") {
			visitsNode.textContent = "计数乌鸦暂时离岗";
		}
	};

	const renderPageVisits = (value, fallback = false) => {
		document.querySelectorAll("[data-page-visit-counter]").forEach((node) => {
			if (!(node instanceof HTMLElement)) {
				return;
			}

			if (typeof value === "number" && Number.isFinite(value) && value >= 0) {
				node.dataset.counterReady = "true";
				node.textContent = `羽毛落点累计 ${formatVisits(value)} 次来回盘旋`;
				return;
			}

			if (fallback && node.dataset.counterReady !== "true") {
				node.textContent = "羽毛落点累计暂时失联";
			}
		});
	};

	const renderVisitorCounts = (counts, fallback = false) => {
		const siteVisitValue = normalizeVisitCount(
			counts?.siteUv ?? counts?.site_uv ?? null,
		);
		const pageVisitValue = normalizeVisitCount(
			counts?.pagePv ?? counts?.page_pv ?? null,
		);

		if (siteVisitValue !== null) {
			renderFooterVisits(siteVisitValue);
		} else if (fallback) {
			renderFooterVisits(null, true);
		}

		if (pageVisitValue !== null) {
			renderPageVisits(pageVisitValue);
		} else if (fallback) {
			renderPageVisits(null, true);
		}
	};

	const scheduleUptimeSync = () => {
		syncFooterUptime();
		if (footerState.uptimeTimer) {
			window.clearInterval(footerState.uptimeTimer);
		}
		footerState.uptimeTimer = window.setInterval(syncFooterUptime, 60000);
	};

	const resetPageVisitCounter = () => {
		document.querySelectorAll("[data-page-visit-counter]").forEach((node) => {
			if (!(node instanceof HTMLElement)) {
				return;
			}

			node.dataset.counterReady = "false";
			node.textContent = "羽毛落点累计清点中...";
		});
	};

	const buildCanonicalPageUrl = () => {
		const pageUrl = new URL(window.location.href);
		pageUrl.search = "";
		pageUrl.hash = "";
		return pageUrl.toString();
	};

	const requestVisitorCounts = async (targetUrl, method = "POST") => {
		const headers = new Headers({
			"x-bsz-referer": targetUrl,
		});
		const identityToken = window.localStorage.getItem(VISITOR_IDENTITY_STORAGE_KEY);
		if (identityToken) {
			headers.set("Authorization", `Bearer ${identityToken}`);
		}

		const response = await fetch(counterApi, {
			method,
			cache: "no-store",
			headers,
		});

		if (!response.ok) {
			throw new Error(`Failed to fetch visitor counts for ${targetUrl}`);
		}

		const payload = await response.json();
		const nextIdentityToken = response.headers.get("Set-Bsz-Identity");
		if (nextIdentityToken) {
			window.localStorage.setItem(VISITOR_IDENTITY_STORAGE_KEY, nextIdentityToken);
		}

		return {
			siteUv: normalizeVisitCount(payload?.data?.site_uv),
			pagePv: normalizeVisitCount(payload?.data?.page_pv),
		};
	};

	const syncVisitorCounter = async () => {
		if (!counterApi) {
			renderVisitorCounts(null, true);
			return;
		}

		const currentPageKey = buildCanonicalPageUrl();
		const cachedCounts = footerState.lastCountsByPageKey[currentPageKey] ?? null;

		if (footerState.pendingPageKey === currentPageKey) {
			if (cachedCounts) {
				renderVisitorCounts(cachedCounts);
			}
			return;
		}

		if (cachedCounts) {
			renderVisitorCounts(cachedCounts);
		} else {
			resetPageVisitCounter();
		}

		if (footerState.activePageKey === currentPageKey) {
			return;
		}

		footerState.activePageKey = currentPageKey;
		footerState.pendingPageKey = currentPageKey;
		const requestToken = ++footerState.requestToken;

		try {
			const counts = await requestVisitorCounts(currentPageKey, "POST");
			if (
				requestToken !== footerState.requestToken ||
				footerState.activePageKey !== currentPageKey
			) {
				return;
			}

			footerState.pendingPageKey = "";
			footerState.lastCountsByPageKey[currentPageKey] = counts;
			renderVisitorCounts(counts);
			footerWindow.__alfCurrentPageVisitorCounts = {
				pageKey: currentPageKey,
				counts,
			};
			document.dispatchEvent(
				new CustomEvent("alf:visitor-counter-updated", {
					detail: {
						pageKey: currentPageKey,
						counts,
					},
				}),
			);
		} catch (_error) {
			if (
				requestToken !== footerState.requestToken ||
				footerState.activePageKey !== currentPageKey
			) {
				return;
			}

			footerState.pendingPageKey = "";
			if (cachedCounts) {
				renderVisitorCounts(cachedCounts);
				return;
			}

			renderVisitorCounts(null, true);
		}
	};

	const syncFooterSignals = () => {
		scheduleUptimeSync();
		void syncVisitorCounter();
	};

	if (!footerWindow[VISITOR_COUNTER_BOUND_KEY]) {
		document.addEventListener("astro:page-load", syncFooterSignals);
		document.addEventListener("DOMContentLoaded", syncFooterSignals);
		footerWindow[VISITOR_COUNTER_BOUND_KEY] = true;
	}

	syncFooterSignals();
</script>
