---
import { profileConfig } from "../../config";
import DashboardActivityPanel from "./DashboardActivityPanel.astro";
import DashboardGuidePanel from "./DashboardGuidePanel.astro";
import DashboardHero from "./DashboardHero.astro";
import DashboardMetricsGrid from "./DashboardMetricsGrid.astro";
import DashboardRecentUpdates from "./DashboardRecentUpdates.astro";
import DashboardSidebar from "./DashboardSidebar.astro";
import DashboardTopbar from "./DashboardTopbar.astro";
import DashboardVisitPanel from "./DashboardVisitPanel.astro";

type ActivityPoint = {
	label: string;
	publish: number;
	update: number;
	delete: number;
};

type VisitGrowthPoint = {
	label: string;
	bucketKey: string;
	totalVisits: number;
	growthRate: number;
};

type VisitGrowthMetric = VisitGrowthPoint & {
	x: number;
	y: number;
};

interface DashboardItem {
	title: string;
	time: string;
	url: string;
	description: string;
	kindLabel: "文章" | "笔记";
}

interface DashboardMetrics {
	updatedEntries: number;
	updatedWords: number;
	contentBreakdown: string;
	contentBreakdownNote: string;
	latestPost: { title: string; url: string; excerpt: string; kindLabel: string };
	latestNote: { title: string; url: string; excerpt: string; kindLabel: string };
	lastUpdatedEntry: { title: string; url: string; excerpt: string; kindLabel: string };
}

interface Props {
	activityDatasets: Record<string, { label: string; points: ActivityPoint[] }>;
	visitDatasets: Record<string, { label: string; points: VisitGrowthPoint[] }>;
	recentUpdates: DashboardItem[];
	dashboardMetrics: DashboardMetrics;
	compact?: boolean;
	showSidebar?: boolean;
}

const {
	activityDatasets,
	visitDatasets,
	recentUpdates,
	dashboardMetrics,
	compact = false,
	showSidebar = true,
}: Props = Astro.props;

const dashboardHeroQuotes = [
	"先把记录写清楚，再谈形式怎么更漂亮。",
	"小步快改，往往比大改版更能积累站点气质。",
	"页面先能用，再慢慢把边角打磨出来。",
	"结构先足够直白，之后再考虑做得巧一点。",
	"首页应该先回答“这里有什么”，再考虑装饰感。",
	"导航够快，本身就是体验的一部分。",
];

const dashboardHints = {
	write: {
		title: "写作流程",
		content: `1. 新建长文：pnpm new-post -- your-slug
2. 新建短笔记：pnpm new-post -- your-note --type note
3. 优先使用目录式内容结构：
   src/content/posts/your-slug/index.md
   src/content/notes/your-note/index.md
4. 图片和附件尽量跟 index.md 放在一起
5. 尽早补齐 title、description、tags、category、categoryPath、series
6. 发布前跑一次 pnpm build`,
	},
	organize: {
		title: "结构约定",
		content: `1. category 负责一级归类
2. categoryPath 用来补足层级路径
3. series 用来聚合同一系列内容
4. 长文放 posts，短内容放 notes
5. 资源优先跟内容同目录，不要无脑堆进 public
6. 标题、摘要和分类信息要尽量保持可检索`,
	},
};

const dashboardSearchItems = [
	{
		title: dashboardMetrics.lastUpdatedEntry.title,
		type: `最近更新 - ${dashboardMetrics.lastUpdatedEntry.kindLabel}`,
		description: dashboardMetrics.lastUpdatedEntry.excerpt,
		url: dashboardMetrics.lastUpdatedEntry.url,
	},
	{
		title: dashboardMetrics.latestPost.title,
		type: `最新文章 - ${dashboardMetrics.latestPost.kindLabel}`,
		description: dashboardMetrics.latestPost.excerpt,
		url: dashboardMetrics.latestPost.url,
	},
	{
		title: dashboardMetrics.latestNote.title,
		type: `最新笔记 - ${dashboardMetrics.latestNote.kindLabel}`,
		description: dashboardMetrics.latestNote.excerpt,
		url: dashboardMetrics.latestNote.url,
	},
	...recentUpdates.map((item) => ({
		title: item.title,
		type: `最近 - ${item.kindLabel}`,
		description: item.description,
		time: item.time,
		url: item.url,
	})),
];

const activityChartPalette = {
	publish: {
		line: "rgb(59, 130, 246)",
		area: "rgba(59, 130, 246, 0.12)",
	},
	update: {
		line: "rgb(14, 165, 233)",
		area: "rgba(14, 165, 233, 0.12)",
	},
	delete: {
		line: "rgb(245, 158, 11)",
		area: "rgba(245, 158, 11, 0.12)",
	},
};

const visitChartColor = {
	line: "rgb(59, 130, 246)",
	area: "rgba(59, 130, 246, 0.12)",
};

const getChartMetrics = (points: VisitGrowthPoint[]): VisitGrowthMetric[] => {
	const growthValues = points.map((point) => point.growthRate);
	const denominator = Math.max(points.length - 1, 1);
	const minValue = Math.min(...growthValues, 0);
	const maxValue = Math.max(...growthValues, 0);
	const isFlat = Math.abs(maxValue - minValue) < 0.0001;
	const padding = isFlat ? 0 : Math.max((maxValue - minValue) * 0.12, 0.5);
	const domainMin = isFlat ? minValue - 1 : minValue - padding;
	const domainMax = isFlat ? maxValue + 1 : maxValue + padding;

	return points.map((point, index) => ({
		...point,
		x: (index / denominator) * 100,
		y: isFlat ? 50 : 100 - ((point.growthRate - domainMin) / (domainMax - domainMin)) * 100,
	}));
};

const defaultRange = "week";
const defaultDataset = visitDatasets[defaultRange];
const defaultMetrics = getChartMetrics(defaultDataset.points);
const defaultSummary = "等待全站访问快照...";
---

<div class:list={["dashboard-shell", { "dashboard-shell--compact": compact, "dashboard-shell--sidebarless": !showSidebar }]}>
	<div class="dashboard-main">
		<DashboardTopbar profileName={profileConfig.name} />
		<DashboardHero greeting={`欢迎回来，${profileConfig.name}`} />
		<DashboardMetricsGrid metrics={dashboardMetrics} />

		<div class="dashboard-grid">
			<DashboardActivityPanel
				chartPalette={activityChartPalette}
				chartDatasets={activityDatasets}
				defaultRange={defaultRange}
			/>
			<div class="dashboard-secondary-grid">
				<DashboardRecentUpdates recentUpdates={recentUpdates.slice(0, 4)} />
				<DashboardVisitPanel
					chartColor={visitChartColor}
					defaultRange={defaultRange}
					defaultMetrics={defaultMetrics}
					defaultSummary={defaultSummary}
				/>
			</div>
			<DashboardGuidePanel />
		</div>
	</div>

	{showSidebar && <DashboardSidebar />}
</div>

<div class="dashboard-hint-overlay" data-dashboard-hint-overlay hidden>
	<section class="dashboard-hint-card" data-dashboard-hint-root role="dialog" aria-modal="true" aria-labelledby="dashboard-hint-title">
		<div class="dashboard-hint-head">
			<div>
				<p class="dashboard-panel-eyebrow">提示</p>
				<h3 class="dashboard-hint-title" id="dashboard-hint-title" data-dashboard-hint-title>内容提示</h3>
			</div>
			<button class="dashboard-hint-close" type="button" aria-label="关闭提示" data-dashboard-hint-close>
				x
			</button>
		</div>
		<textarea class="dashboard-hint-textbox" data-dashboard-hint-content readonly spellcheck="false"></textarea>
	</section>
</div>

<script id="dashboard-chart-data" type="application/json" is:inline set:html={JSON.stringify(visitDatasets)}></script>
<script id="dashboard-hint-data" type="application/json" is:inline set:html={JSON.stringify(dashboardHints)}></script>
<script id="dashboard-search-data" type="application/json" is:inline set:html={JSON.stringify(dashboardSearchItems)}></script>
<script id="dashboard-hero-quotes" type="application/json" is:inline set:html={JSON.stringify(dashboardHeroQuotes)}></script>

<script is:inline>
	const SITE_VISIT_HISTORY_STORAGE_KEY = "alf-site-visit-history-v1";
	const DASHBOARD_VISIT_EVENT_BOUND_KEY = "__alfDashboardVisitEventBound";

	const normalizeVisitCount = (value) => {
		if (typeof value === "number" && Number.isFinite(value)) {
			return Math.max(0, Math.floor(value));
		}

		if (typeof value === "string") {
			const parsedValue = Number.parseInt(value.replace(/[^\d]/g, ""), 10);
			if (Number.isFinite(parsedValue)) {
				return Math.max(0, parsedValue);
			}
		}

		return null;
	};

	const formatVisits = (count) =>
		new Intl.NumberFormat("zh-CN").format(Math.max(0, Math.floor(count)));
	const formatGrowthRate = (value) => {
		const safeValue = Number.isFinite(value) ? value : 0;
		const formatter = new Intl.NumberFormat("zh-CN", {
			minimumFractionDigits: Math.abs(safeValue) >= 10 ? 1 : 2,
			maximumFractionDigits: Math.abs(safeValue) >= 10 ? 1 : 2,
		});
		return `${safeValue >= 0 ? "+" : ""}${formatter.format(safeValue)}%`;
	};

	const buildMetrics = (points) => {
		const growthValues = points.map((point) =>
			typeof point.growthRate === "number" && Number.isFinite(point.growthRate)
				? point.growthRate
				: 0,
		);
		const denominator = Math.max(points.length - 1, 1);
		const minValue = Math.min(...growthValues, 0);
		const maxValue = Math.max(...growthValues, 0);
		const isFlat = Math.abs(maxValue - minValue) < 0.0001;
		const padding = isFlat ? 0 : Math.max((maxValue - minValue) * 0.12, 0.5);
		const domainMin = isFlat ? minValue - 1 : minValue - padding;
		const domainMax = isFlat ? maxValue + 1 : maxValue + padding;

		return points.map((point, index) => ({
			...point,
			x: (index / denominator) * 100,
			y: isFlat
				? 50
				: 100 - ((point.growthRate - domainMin) / (domainMax - domainMin)) * 100,
		}));
	};

	const buildAreaPath = (metrics) =>
		`M 0 100 ${metrics.map((point) => `L ${point.x} ${point.y}`).join(" ")} L 100 100 Z`;
	const buildLinePath = (metrics) =>
		`M ${metrics.map((point) => `${point.x} ${point.y}`).join(" L ")}`;
	const summarizeDataset = (dataset) => {
		const validPoints = dataset.points.filter((point) => point.totalVisits > 0);
		if (validPoints.length === 0) {
			return `${dataset.label}：等待全站访问快照。`;
		}

		const latestPoint = validPoints[validPoints.length - 1];
		if (validPoints.length < 2) {
			return `${dataset.label}：当前全站访问量 ${formatVisits(latestPoint.totalVisits)}，继续积累快照后显示增长率。`;
		}

		const firstPoint = validPoints[0];
		const rangeGrowthRate =
			firstPoint.totalVisits > 0
				? ((latestPoint.totalVisits - firstPoint.totalVisits) / firstPoint.totalVisits) * 100
				: 0;
		return `${dataset.label}：当前全站访问量 ${formatVisits(latestPoint.totalVisits)}，较首个有效采样点增长 ${formatGrowthRate(rangeGrowthRate)}。`;
	};

	const getColumnWidth = (range, pointCount) => {
		if (range === "month") {
			return "2.2rem";
		}

		if (range === "year") {
			return "3rem";
		}

		return pointCount > 14 ? "2.5rem" : "2.9rem";
	};
	const shouldShowChartLabel = (range, index, total) => {
		if (total <= 7) {
			return true;
		}

		if (range === "month") {
			return index === 0 || index === total - 1 || index % 5 === 4;
		}

		if (range === "year") {
			return index === 0 || index === total - 1 || index % 2 === 1;
		}

		return index === 0 || index === total - 1 || index % 2 === 0;
	};

	const readSiteVisitHistory = () => {
		try {
			const rawHistory = window.localStorage.getItem(SITE_VISIT_HISTORY_STORAGE_KEY);
			if (!rawHistory) {
				return [];
			}

			const parsedHistory = JSON.parse(rawHistory);
			if (!Array.isArray(parsedHistory)) {
				return [];
			}

			return parsedHistory
				.map((entry) => ({
					dayKey: typeof entry?.dayKey === "string" ? entry.dayKey : "",
					timestamp:
						typeof entry?.timestamp === "number" && Number.isFinite(entry.timestamp)
							? entry.timestamp
							: 0,
					siteUv: normalizeVisitCount(entry?.siteUv),
				}))
				.filter((entry) => entry.dayKey && entry.siteUv !== null)
				.sort((left, right) => left.timestamp - right.timestamp);
		} catch (_error) {
			return [];
		}
	};

	const buildVisitDatasets = (sourceDatasets) => {
		const history = readSiteVisitHistory();
		const dayTotals = new Map();
		const monthTotals = new Map();

		history.forEach((entry) => {
			const siteUv = entry.siteUv ?? 0;
			dayTotals.set(entry.dayKey, Math.max(dayTotals.get(entry.dayKey) ?? 0, siteUv));

			const monthKey = entry.dayKey.slice(0, 7);
			monthTotals.set(monthKey, Math.max(monthTotals.get(monthKey) ?? 0, siteUv));
		});

		const hydratePoints = (points, totalMap) => {
			let carriedTotal = 0;
			let previousTotal = null;

			return points.map((point) => {
				const observedTotal = normalizeVisitCount(totalMap.get(point.bucketKey));
				if (observedTotal !== null) {
					carriedTotal = Math.max(carriedTotal, observedTotal);
				}

				const totalVisits = carriedTotal;
				const growthRate =
					typeof previousTotal === "number" && previousTotal > 0 && totalVisits >= previousTotal
						? ((totalVisits - previousTotal) / previousTotal) * 100
						: 0;

				if (totalVisits > 0) {
					previousTotal = totalVisits;
				}

				return {
					...point,
					totalVisits,
					growthRate,
				};
			});
		};

		return {
			week: sourceDatasets?.week
				? {
						...sourceDatasets.week,
						points: hydratePoints(sourceDatasets.week.points, dayTotals),
					}
				: null,
			month: sourceDatasets?.month
				? {
						...sourceDatasets.month,
						points: hydratePoints(sourceDatasets.month.points, dayTotals),
					}
				: null,
			year: sourceDatasets?.year
				? {
						...sourceDatasets.year,
						points: hydratePoints(sourceDatasets.year.points, monthTotals),
					}
				: null,
		};
	};

	const getLatestSiteVisitTotal = () => {
		const currentCounts = window.__alfCurrentPageVisitorCounts?.counts;
		const currentSiteUv = normalizeVisitCount(
			currentCounts?.siteUv ?? currentCounts?.site_uv ?? null,
		);
		if (currentSiteUv !== null) {
			return currentSiteUv;
		}

		const history = readSiteVisitHistory();
		const latestEntry = history[history.length - 1];
		return latestEntry?.siteUv ?? null;
	};

	const renderDashboardSiteVisits = () => {
		const latestSiteVisits = getLatestSiteVisitTotal();

		document.querySelectorAll("[data-dashboard-site-visits]").forEach((node) => {
			if (!(node instanceof HTMLElement)) {
				return;
			}

			if (latestSiteVisits !== null) {
				node.dataset.counterReady = "true";
				node.textContent = `${formatVisits(latestSiteVisits)} 次`;
				return;
			}

			if (node.dataset.counterReady !== "true") {
				node.textContent = "统计中...";
			}
		});
	};

	const initDashboardTypewriter = () => {
		const node = document.querySelector("[data-dashboard-typewriter]");
		const quoteNode = document.querySelector("[data-dashboard-hero-quote]");
		const quoteShell = document.querySelector("[data-dashboard-hero-quote-shell]");
		const quotesNode = document.querySelector("#dashboard-hero-quotes");

		if (!node || !quoteNode || !quoteShell || !quotesNode) {
			return;
		}

		const fullText = node.dataset.dashboardTypewriterText || "";
		const previousTimer = Number(node.dataset.dashboardTypewriterTimer || "0");
		const previousExpandTimer = Number(node.dataset.dashboardQuoteShellTimer || "0");
		const previousRevealTimer = Number(node.dataset.dashboardQuoteTimer || "0");
		const quotes = JSON.parse(quotesNode.textContent || "[]");
		const randomQuote =
			Array.isArray(quotes) && quotes.length > 0
				? quotes[Math.floor(Math.random() * quotes.length)]
				: "";

		if (previousTimer) {
			window.clearTimeout(previousTimer);
		}

		if (previousExpandTimer) {
			window.clearTimeout(previousExpandTimer);
		}

		if (previousRevealTimer) {
			window.clearTimeout(previousRevealTimer);
		}

		node.textContent = "";
		quoteShell.hidden = true;
		quoteShell.classList.remove("is-expanded");
		quoteNode.hidden = true;
		quoteNode.classList.remove("is-visible");
		quoteNode.textContent = randomQuote;

		let index = 0;

		const tick = () => {
			node.textContent = fullText.slice(0, index);
			index += 1;

			if (index <= fullText.length) {
				const timer = window.setTimeout(tick, 120);
				node.dataset.dashboardTypewriterTimer = String(timer);
				return;
			}

			node.dataset.dashboardTypewriterTimer = "";

			if (randomQuote) {
				const expandTimer = window.setTimeout(() => {
					quoteShell.hidden = false;
					window.requestAnimationFrame(() => {
						quoteShell.classList.add("is-expanded");
					});

					const revealTimer = window.setTimeout(() => {
						quoteNode.hidden = false;
						window.requestAnimationFrame(() => {
							quoteNode.classList.add("is-visible");
						});
					}, 320);
					node.dataset.dashboardQuoteTimer = String(revealTimer);
				}, 220);
				node.dataset.dashboardQuoteShellTimer = String(expandTimer);
				return;
			}

			node.dataset.dashboardQuoteShellTimer = "";
			node.dataset.dashboardQuoteTimer = "";
		};

		tick();
	};

	const initDashboardSearch = () => {
		const root = document.querySelector("[data-dashboard-search]");
		const input = document.querySelector("[data-dashboard-search-input]");
		const results = document.querySelector("[data-dashboard-search-results]");
		const listNode = document.querySelector("[data-dashboard-search-list]");
		const emptyNode = document.querySelector("[data-dashboard-search-empty]");
		const dataNode = document.querySelector("#dashboard-search-data");

		if (!root || !input || !results || !listNode || !emptyNode || !dataNode) {
			return;
		}

		if (root.dataset.dashboardSearchInitialized === "true") {
			return;
		}
		root.dataset.dashboardSearchInitialized = "true";

		const items = JSON.parse(dataNode.textContent || "[]");
		const normalize = (value) => String(value || "").trim().toLowerCase();
		const dashboardWindow = window;
		const outsideClickHandlerKey = "__alfDashboardSearchOutsideClickBound";
		const createResultNode = (item) => {
			const link = document.createElement("a");
			link.className = "dashboard-search-result";
			link.href = item.url;

			const meta = document.createElement("div");
			meta.className = "dashboard-search-result-meta";
			meta.textContent = `${item.type}${item.time ? ` · ${item.time}` : ""}`;

			const title = document.createElement("div");
			title.className = "dashboard-search-result-title";
			title.textContent = item.title;

			const copy = document.createElement("div");
			copy.className = "dashboard-search-result-copy";
			copy.textContent = item.description;

			link.append(meta, title, copy);
			return link;
		};

		const renderResults = (query = "") => {
			const keyword = normalize(query);
			const matchedItems = items
				.filter((item) => {
					if (!keyword) {
						return true;
					}

					return [item.title, item.type, item.description, item.time].some((field) =>
						normalize(field).includes(keyword),
					);
				})
				.slice(0, 5);

			listNode.replaceChildren();

			if (matchedItems.length === 0) {
				emptyNode.hidden = false;
				results.hidden = false;
				return;
			}

			emptyNode.hidden = true;
			matchedItems.forEach((item) => {
				listNode.appendChild(createResultNode(item));
			});

			results.hidden = false;
		};

		input.onfocus = () => renderResults(input.value);
		input.oninput = () => renderResults(input.value);

		if (!dashboardWindow[outsideClickHandlerKey]) {
			dashboardWindow[outsideClickHandlerKey] = true;
			document.addEventListener("click", (event) => {
				const currentRoot = document.querySelector("[data-dashboard-search]");
				const currentResults = document.querySelector("[data-dashboard-search-results]");
				if (!(currentRoot instanceof HTMLElement) || !(currentResults instanceof HTMLElement)) {
					return;
				}

				if (!currentRoot.contains(event.target)) {
					currentResults.hidden = true;
				}
			});
		}
	};

	const initDashboardHints = () => {
		const dataNode = document.querySelector("#dashboard-hint-data");
		const overlay = document.querySelector("[data-dashboard-hint-overlay]");
		const titleNode = document.querySelector("[data-dashboard-hint-title]");
		const contentNode = document.querySelector("[data-dashboard-hint-content]");
		const closeButton = document.querySelector("[data-dashboard-hint-close]");
		const triggers = document.querySelectorAll("[data-dashboard-hint-trigger]");

		if (!dataNode || !overlay || !titleNode || !contentNode || !closeButton || triggers.length === 0) {
			return;
		}

		const hints = JSON.parse(dataNode.textContent || "{}");

		const openHint = (key) => {
			const hint = hints[key];
			if (!hint) {
				return;
			}

			titleNode.textContent = hint.title;
			contentNode.value = hint.content;
			overlay.hidden = false;
		};

		const closeHint = () => {
			overlay.hidden = true;
		};

		triggers.forEach((trigger) => {
			trigger.onclick = () => openHint(trigger.dataset.dashboardHintTrigger);
		});

		closeButton.onclick = closeHint;
		overlay.onclick = (event) => {
			if (event.target === overlay) {
				closeHint();
			}
		};
	};

	const renderDashboardChart = () => {
		const dataNode = document.querySelector("#dashboard-chart-data");
		const chartRoot = document.querySelector("[data-chart-root]");
		const switchRoot = document.querySelector("[data-chart-switch]");
		const summaryNode = document.querySelector("[data-chart-summary]");
		const svg = document.querySelector("[data-chart-svg]");
		const labels = document.querySelector("[data-chart-labels]");
		if (!dataNode || !chartRoot || !switchRoot || !summaryNode || !svg || !labels) {
			return;
		}

		const datasets = buildVisitDatasets(JSON.parse(dataNode.textContent || "{}"));
		const [area, line] = svg.querySelectorAll("path");
		const activeRange = chartRoot.dataset.currentRange || chartRoot.dataset.defaultRange || "week";
		const dataset = datasets[activeRange];
		if (!dataset) {
			return;
		}

		const metrics = buildMetrics(dataset.points);
		switchRoot.dataset.activeIndex =
			activeRange === "week" ? "0" : activeRange === "month" ? "1" : "2";
		switchRoot.querySelectorAll("[data-range-option]").forEach((button) => {
			const active = button.dataset.rangeOption === activeRange;
			button.classList.toggle("is-active", active);
			button.setAttribute("aria-selected", active ? "true" : "false");
		});

		area?.setAttribute("d", buildAreaPath(metrics));
		line?.setAttribute("d", buildLinePath(metrics));
		summaryNode.textContent = summarizeDataset(dataset);
		chartRoot.style.setProperty("--chart-base-point-count", String(metrics.length));
		chartRoot.style.setProperty("--chart-base-column-width", getColumnWidth(activeRange, metrics.length));
		labels.style.gridTemplateColumns = `repeat(${metrics.length}, minmax(0, 1fr))`;
		labels.replaceChildren(
			...metrics.map((point, index) => {
				const item = document.createElement("span");
				item.className = "dashboard-chart-label";
				const visible = shouldShowChartLabel(activeRange, index, metrics.length);
				item.textContent = visible ? point.label : "";
				item.setAttribute("aria-hidden", visible ? "false" : "true");
				if (!visible) {
					item.classList.add("is-placeholder");
				}
				return item;
			}),
		);
	};

	const initDashboardChart = () => {
		const chartRoot = document.querySelector("[data-chart-root]");
		const switchRoot = document.querySelector("[data-chart-switch]");
		if (!chartRoot || !switchRoot) {
			return;
		}

		if (chartRoot.dataset.chartInitialized !== "true") {
			switchRoot.querySelectorAll("[data-range-option]").forEach((button) => {
				button.onclick = () => {
					chartRoot.dataset.currentRange = button.dataset.rangeOption || "week";
					renderDashboardChart();
				};
			});
			chartRoot.dataset.chartInitialized = "true";
		}

		renderDashboardSiteVisits();
		renderDashboardChart();

		if (!window[DASHBOARD_VISIT_EVENT_BOUND_KEY]) {
			document.addEventListener("alf:visitor-counter-updated", () => {
				renderDashboardSiteVisits();
				renderDashboardChart();
			});
			window[DASHBOARD_VISIT_EVENT_BOUND_KEY] = true;
		}
	};

	const bootDashboard = () => {
		initDashboardTypewriter();
		initDashboardSearch();
		initDashboardHints();
		initDashboardChart();
	};

	document.addEventListener("astro:page-load", bootDashboard);
	document.addEventListener("DOMContentLoaded", bootDashboard);
</script>

