---
import { url } from "../utils/url-utils";

const modelPath = url("/live2d/models/ug/ugofficial.model3.json");
const localCorePath = url("/live2d/vendor/live2dcubismcore.min.js");
const officialCoreUrl =
	"https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js";
const pixiUrl = "https://cdn.jsdelivr.net/npm/pixi.js@6.5.10/dist/browser/pixi.min.js";
const live2dUrl =
	"https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js";
const expressionNames = [
	"1desk",
	"2mic",
	"3clever",
	"4OAO",
	"5QAQ",
	"6i gi a ri",
	"7keyboard",
	"8punch",
	"9",
];
const normalExpressionNames = ["1desk", "2mic", "3clever", "9"];
const interactiveExpressionNames = ["5QAQ", "6i gi a ri", "7keyboard", "8punch"];
const fastPointerExpressionName = "4OAO";
---

<div
	id="live2d-mascot"
	class="live2d-mascot"
	data-expression-names={JSON.stringify(expressionNames)}
	data-normal-expression-names={JSON.stringify(normalExpressionNames)}
	data-interactive-expression-names={JSON.stringify(interactiveExpressionNames)}
	data-fast-pointer-expression-name={fastPointerExpressionName}
	data-live2d-url={live2dUrl}
	data-local-core-path={localCorePath}
	data-model-path={modelPath}
	data-official-core-url={officialCoreUrl}
	data-pixi-url={pixiUrl}
	aria-live="polite"
>
	<section class="live2d-mascot__panel" aria-label="Live2D 看板娘">
		<div class="live2d-mascot__status" data-live2d-status>看板娘加载中</div>
		<canvas
			class="live2d-mascot__canvas"
			data-live2d-canvas
			width="320"
			height="420"
			aria-hidden="true"
		></canvas>
	</section>
</div>

<style>
	.live2d-mascot {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 70;
		pointer-events: none;
		touch-action: none;
	}

	.live2d-mascot__panel {
		position: relative;
		width: calc(clamp(11rem, 16vw, 16rem) * var(--live2d-scale, 1));
		aspect-ratio: 32 / 42;
		background: transparent;
		border: 0;
		box-shadow: none;
		overflow: visible;
		pointer-events: none;
		transition: width 180ms ease;
	}

	.live2d-mascot__status {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 2;
		max-width: calc(100% - 1rem);
		padding: 0.3rem 0.55rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.28);
		color: rgb(51 65 85 / 0.82);
		font-size: 0.7rem;
		letter-spacing: 0.03em;
		backdrop-filter: blur(8px);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		pointer-events: none;
	}

	.dark .live2d-mascot__status {
		background: rgb(15 23 42 / 0.3);
		color: rgb(226 232 240 / 0.84);
	}

	.live2d-mascot__status[data-mode="error"] {
		color: rgb(185 28 28 / 0.92);
		background: rgb(254 242 242 / 0.5);
	}

	.dark .live2d-mascot__status[data-mode="error"] {
		color: rgb(254 202 202 / 0.94);
		background: rgb(69 10 10 / 0.4);
	}

	.live2d-mascot__canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: auto;
		cursor: pointer;
		filter: drop-shadow(0 1rem 2rem rgb(15 23 42 / 0.16));
	}

	.live2d-mascot[data-locked="false"] .live2d-mascot__canvas {
		cursor: grab;
	}

	.live2d-mascot[data-locked="false"] .live2d-mascot__canvas:active {
		cursor: grabbing;
	}

	@media (max-width: 1023px) {
		.live2d-mascot__panel {
			width: calc(clamp(8.5rem, 30vw, 11rem) * var(--live2d-scale, 1));
		}

		.live2d-mascot__status {
			display: none;
		}
	}
</style>

<script>
	// @ts-nocheck
	(() => {
		if (window.__alfLive2DMascotSetup) {
			return;
		}
		window.__alfLive2DMascotSetup = true;

		const root = document.getElementById("live2d-mascot");
		if (!(root instanceof HTMLElement)) {
			return;
		}

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		if (prefersReducedMotion.matches || window.innerWidth < 1024) {
			root.hidden = true;
			root.setAttribute("aria-hidden", "true");
			document.documentElement.dataset.mascotHidden = "true";
			return;
		}

		const expressionNames = JSON.parse(root.dataset.expressionNames || "[]");
		const normalExpressionNames = JSON.parse(
			root.dataset.normalExpressionNames || "[]",
		);
		const interactiveExpressionNames = JSON.parse(
			root.dataset.interactiveExpressionNames || "[]",
		);
		const fastPointerExpressionName = root.dataset.fastPointerExpressionName || "4OAO";
		const live2dUrl = root.dataset.live2dUrl || "";
		const localCorePath = root.dataset.localCorePath || "";
		const modelPath = root.dataset.modelPath || "";
		const officialCoreUrl = root.dataset.officialCoreUrl || "";
		const pixiUrl = root.dataset.pixiUrl || "";
		const panel = root.querySelector(".live2d-mascot__panel");
		const canvas = root.querySelector("[data-live2d-canvas]");
		const status = root.querySelector("[data-live2d-status]");

		if (
			!(panel instanceof HTMLElement) ||
			!(canvas instanceof HTMLCanvasElement) ||
			!(status instanceof HTMLElement)
		) {
			return;
		}

		const state = {
			app: null,
			model: null,
			initPromise: null,
			baseSize: null,
			currentExpression: "",
			expressionMode: "normal",
			normalExpressionTimer: null,
			interactiveExpressionTimer: null,
			normalExpressionTimerStartedAt: 0,
			interactiveExpressionTimerStartedAt: 0,
			normalExpressionTimerRemainingMs: 0,
			interactiveExpressionTimerRemainingMs: 0,
			lastNormalExpression: "",
			lastInteractiveExpression: "",
			pausedExpressionMode: "",
			pausedExpressionName: "",
			pausedExpressionTimerRemainingMs: 0,
			expressionRequestId: 0,
			position: null,
			dragPointerId: null,
			dragStartX: 0,
			dragStartY: 0,
			dragOriginX: 0,
			dragOriginY: 0,
			dragMoved: false,
			locked: false,
			gazeTargetX: 0,
			gazeTargetY: 0,
			gazeCurrentX: 0,
			gazeCurrentY: 0,
			gazePointerActive: false,
			gazeTickerBound: false,
			gazeIdleTargetX: 0,
			gazeIdleTargetY: 0,
			gazeIdleNextAt: 0,
			lastMouseX: 0,
			lastMouseY: 0,
			hasMousePosition: false,
			lastPointerMoveAt: 0,
			dizzinessScore: 0,
			lastHeadAngleX: 0,
			lastHeadAngleY: 0,
			lastHeadVelocityX: 0,
			lastHeadVelocityY: 0,
			lastGazeTickAt: 0,
		};

		const positionStorageKey = "alf.live2d.position";
		const lockStorageKey = "system:mascot-locked";
		const visibilityStorageKey = "system:mascot-hidden";
		const viewportPadding = 8;
		const normalExpressionIntervalMs = 30000;
		const interactiveExpressionDurationMs = 15000;
		const gazeConfig = {
			directionX: -1,
			directionY: 1,
			eyeBallX: 0.72,
			eyeBallY: 0.58,
			angleX: 7.2,
			angleY: 5.2,
			angleZ: 1.1,
			bodyAngleX: 1.6,
			bodyAngleY: 0.7,
			smoothing: 0.34,
			idleSmoothing: 0.045,
			returnSpeed: 0.14,
			deadZone: 0.03,
			pointerRangeX: 1.8,
			pointerRangeY: 2.15,
			minViewportRangeX: 0.16,
			minViewportRangeY: 0.18,
			idleDelayMs: 1400,
			idleHoldMinMs: 1800,
			idleHoldMaxMs: 3600,
			idleRangeX: 0.2,
			idleRangeY: 0.12,
			nearCancelRangeX: 0.34,
			nearCancelRangeY: 0.3,
			headBobAmplitudeY: 0.06,
			headBobSpeed: 0.0038,
			dizzinessRecentWindowMs: 180,
			dizzinessVelocityFloorDegPerSecond: 55,
			dizzinessVelocityCeilingDegPerSecond: 420,
			dizzinessScoreGainPerSecond: 3.1,
			dizzinessDirectionChangeBonusPerSecond: 1.15,
			dizzinessActiveDecayPerSecond: 0.45,
			dizzinessIdleDecayPerSecond: 1.35,
			dizzinessEnterThreshold: 1,
			dizzinessExitThreshold: 0.28,
			faceCenterX: 0.5,
			faceCenterY: 0.38,
		};

		state.normalExpressionTimerRemainingMs = normalExpressionIntervalMs;
		state.interactiveExpressionTimerRemainingMs = interactiveExpressionDurationMs;

		const setStatus = (message, mode = "info") => {
			status.textContent = message;
			status.dataset.mode = mode;
			status.hidden = message.length === 0;
		};

		const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

		const lerp = (from, to, factor) => from + (to - from) * factor;

		const randomBetween = (min, max) => min + Math.random() * (max - min);

		const clearExpressionTimer = (timerName) => {
			if (state[timerName]) {
				window.clearTimeout(state[timerName]);
				state[timerName] = null;
			}
		};

		const getTimerStartedAtKey = (mode) =>
			mode === "interactive"
				? "interactiveExpressionTimerStartedAt"
				: "normalExpressionTimerStartedAt";

		const getTimerRemainingKey = (mode) =>
			mode === "interactive"
				? "interactiveExpressionTimerRemainingMs"
				: "normalExpressionTimerRemainingMs";

		const getTimerHandleKey = (mode) =>
			mode === "interactive" ? "interactiveExpressionTimer" : "normalExpressionTimer";

		const getModeDuration = (mode) =>
			mode === "interactive"
				? interactiveExpressionDurationMs
				: normalExpressionIntervalMs;

		const getRemainingTimeForMode = (mode) => {
			if (mode !== "normal" && mode !== "interactive") {
				return 0;
			}

			const startedAtKey = getTimerStartedAtKey(mode);
			const remainingKey = getTimerRemainingKey(mode);
			const handleKey = getTimerHandleKey(mode);
			if (!state[handleKey]) {
				return Number(state[remainingKey]) || 0;
			}

			const elapsed = Math.max(0, performance.now() - (Number(state[startedAtKey]) || 0));
			return Math.max(0, (Number(state[remainingKey]) || 0) - elapsed);
		};

		const clearModeTimer = (mode) => {
			if (mode !== "normal" && mode !== "interactive") {
				return;
			}

			const handleKey = getTimerHandleKey(mode);
			const startedAtKey = getTimerStartedAtKey(mode);
			clearExpressionTimer(handleKey);
			state[startedAtKey] = 0;
		};

		const pauseCurrentExpressionMode = () => {
			const mode = state.expressionMode;
			if (mode !== "normal" && mode !== "interactive") {
				state.pausedExpressionMode = "";
				state.pausedExpressionName = "";
				state.pausedExpressionTimerRemainingMs = 0;
				return;
			}

			state.pausedExpressionMode = mode;
			state.pausedExpressionName = state.currentExpression;
			state.pausedExpressionTimerRemainingMs = getRemainingTimeForMode(mode);
			clearModeTimer(mode);
		};

		const pickRandomExpression = (pool, disallowedNames = []) => {
			const disallowed = new Set(disallowedNames.filter(Boolean));
			const preferredPool = pool.filter((name) => !disallowed.has(name));
			const sourcePool = preferredPool.length > 0 ? preferredPool : pool;
			if (sourcePool.length === 0) {
				return "";
			}

			const randomIndex = Math.floor(Math.random() * sourcePool.length);
			return sourcePool[randomIndex];
		};

		const applyDeadZone = (value) =>
			Math.abs(value) < gazeConfig.deadZone ? 0 : clamp(value, -1, 1);

		const clampGazeVector = (x, y) => {
			const nextX = applyDeadZone(x);
			const nextY = applyDeadZone(y);
			const magnitude = Math.hypot(nextX, nextY);
			if (magnitude <= 1) {
				return { x: nextX, y: nextY };
			}

			return {
				x: nextX / magnitude,
				y: nextY / magnitude,
			};
		};

		const calibrateGaze = (x, y) => ({
			x: clamp(x * gazeConfig.directionX, -1, 1),
			y: clamp(y * gazeConfig.directionY, -1, 1),
		});

		const getHeadPoseAngles = (x, y) => {
			const calibrated = calibrateGaze(x, y);
			return {
				x: calibrated.x * gazeConfig.angleX,
				y: calibrated.y * gazeConfig.angleY,
			};
		};

		const updateDizzinessScore = (angleX, angleY, frameDt, mouseDriven) => {
			if (frameDt <= 0) {
				state.lastHeadAngleX = angleX;
				state.lastHeadAngleY = angleY;
				return;
			}

			const dtSeconds = Math.max(frameDt / 1000, 1 / 240);
			const velocityX = (angleX - state.lastHeadAngleX) / dtSeconds;
			const velocityY = (angleY - state.lastHeadAngleY) / dtSeconds;
			const angularVelocity = Math.hypot(velocityX, velocityY);
			const normalizedVelocity = clamp(
				(angularVelocity - gazeConfig.dizzinessVelocityFloorDegPerSecond) /
					Math.max(
						gazeConfig.dizzinessVelocityCeilingDegPerSecond -
							gazeConfig.dizzinessVelocityFloorDegPerSecond,
						1,
					),
				0,
				1,
			);

			let directionChangeStrength = 0;
			const previousVelocityMagnitude = Math.hypot(
				state.lastHeadVelocityX,
				state.lastHeadVelocityY,
			);
			if (angularVelocity > 0.001 && previousVelocityMagnitude > 0.001) {
				const directionDot =
					(velocityX * state.lastHeadVelocityX +
						velocityY * state.lastHeadVelocityY) /
					(angularVelocity * previousVelocityMagnitude);
				directionChangeStrength = clamp((-directionDot - 0.08) / 0.92, 0, 1);
			}

			const scoreGain = mouseDriven
				? ((normalizedVelocity * normalizedVelocity) *
					gazeConfig.dizzinessScoreGainPerSecond +
					directionChangeStrength *
						normalizedVelocity *
						gazeConfig.dizzinessDirectionChangeBonusPerSecond) *
					dtSeconds
				: 0;
			const scoreDecay =
				(mouseDriven
					? gazeConfig.dizzinessActiveDecayPerSecond
					: gazeConfig.dizzinessIdleDecayPerSecond) * dtSeconds;

			state.dizzinessScore = clamp(state.dizzinessScore - scoreDecay + scoreGain, 0, 4);
			state.lastHeadAngleX = angleX;
			state.lastHeadAngleY = angleY;
			state.lastHeadVelocityX = velocityX;
			state.lastHeadVelocityY = velocityY;
		};

		const persistPlacement = () => {
			if (!state.position) {
				return;
			}

			try {
				localStorage.setItem(positionStorageKey, JSON.stringify(state.position));
			} catch (_error) {
				// Ignore storage failures.
			}
		};

		const getPanelSize = () => ({
			width: Math.max(panel.offsetWidth || 0, 1),
			height: Math.max(panel.offsetHeight || 0, 1),
		});

		const getBottomRightPosition = () => {
			const size = getPanelSize();
			return clampPosition(
				window.innerWidth - size.width - 12,
				window.innerHeight - size.height - 4,
			);
		};

		const clampPosition = (x, y) => {
			const size = getPanelSize();
			const maxX = Math.max(window.innerWidth - size.width - viewportPadding, viewportPadding);
			const maxY = Math.max(
				window.innerHeight - size.height - viewportPadding,
				viewportPadding,
			);
			return {
				x: Math.min(Math.max(x, viewportPadding), maxX),
				y: Math.min(Math.max(y, viewportPadding), maxY),
			};
		};

		const applyPosition = (x, y) => {
			const nextPosition = clampPosition(x, y);
			state.position = nextPosition;
			root.style.left = `${nextPosition.x}px`;
			root.style.top = `${nextPosition.y}px`;
		};

		const persistLockState = (locked) => {
			try {
				localStorage.setItem(lockStorageKey, locked ? "true" : "false");
			} catch (_error) {
				// Ignore storage failures.
			}
		};

		const applyLockedPlacement = () => {
			const lockedPosition = getBottomRightPosition();
			applyPosition(lockedPosition.x, lockedPosition.y);
			persistPlacement();
		};

		const setLockedState = (locked, shouldPersist = true) => {
			state.locked = locked;
			root.dataset.locked = locked ? "true" : "false";
			document.documentElement.dataset.mascotLocked = locked ? "true" : "false";

			if (locked) {
				if (state.dragPointerId !== null) {
					canvas.releasePointerCapture?.(state.dragPointerId);
				}
				state.dragPointerId = null;
				state.dragMoved = false;
				window.requestAnimationFrame(() => {
					applyLockedPlacement();
				});
			}

			if (shouldPersist) {
				persistLockState(locked);
			}
		};

		const restorePlacement = () => {
			const fallback = getBottomRightPosition();

			if (state.locked) {
				applyPosition(fallback.x, fallback.y);
				return;
			}

			let restoredPosition = fallback;

			try {
				const storedPosition = localStorage.getItem(positionStorageKey);
				if (storedPosition) {
					const parsed = JSON.parse(storedPosition);
					if (
						parsed &&
						typeof parsed.x === "number" &&
						typeof parsed.y === "number"
					) {
						restoredPosition = clampPosition(parsed.x, parsed.y);
					}
				}
			} catch (_error) {
				restoredPosition = fallback;
			}

			applyPosition(restoredPosition.x, restoredPosition.y);
		};

		const scriptCache =
			window.__alfLive2DScriptCache || (window.__alfLive2DScriptCache = new Map());

		const ensureScript = (src, test) => {
			if (typeof test === "function" && test()) {
				return Promise.resolve();
			}

			if (scriptCache.has(src)) {
				return scriptCache.get(src);
			}

			const pending = new Promise((resolve, reject) => {
				const script = document.createElement("script");
				script.src = src;
				script.async = true;
				script.onload = () => {
					if (!test || test()) {
						resolve();
						return;
					}

					reject(new Error(`Script loaded but runtime was unavailable: ${src}`));
				};
				script.onerror = () => reject(new Error(`Failed to load script: ${src}`));
				document.head.appendChild(script);
			});

			scriptCache.set(src, pending);
			return pending;
		};

		const ensureCubismCore = async () => {
			if (window.Live2DCubismCore) {
				return;
			}

			try {
				await ensureScript(localCorePath, () => Boolean(window.Live2DCubismCore));
			} catch (_error) {
				await ensureScript(officialCoreUrl, () => Boolean(window.Live2DCubismCore));
			}
		};

		const fitModel = () => {
			if (!state.app || !state.model) {
				return;
			}

			const width = Math.max(panel.clientWidth, 1);
			const height = Math.max(panel.clientHeight, 1);
			state.app.renderer.resize(width, height);

			const baseWidth = state.baseSize?.width || state.model.width;
			const baseHeight = state.baseSize?.height || state.model.height;
			const scale = Math.min((width * 0.78) / baseWidth, (height * 0.92) / baseHeight);
			state.model.anchor.set(0.5, 1);
			state.model.scale.set(scale);
			state.model.position.set(width * 0.5, height * 0.99);
		};

		const getCoreModel = () => state.model?.internalModel?.coreModel ?? null;

		const addCoreModelParameter = (parameterId, amount) => {
			const coreModel = getCoreModel();
			if (!coreModel || Math.abs(amount) < 0.0001) {
				return false;
			}

			if (typeof coreModel.addParameterValueById === "function") {
				coreModel.addParameterValueById(parameterId, amount, 1);
				return true;
			}

			if (
				typeof coreModel.getParameterValueById === "function" &&
				typeof coreModel.setParameterValueById === "function"
			) {
				const currentValue = Number(coreModel.getParameterValueById(parameterId)) || 0;
				coreModel.setParameterValueById(parameterId, currentValue + amount, 1);
				return true;
			}

			if (typeof coreModel.setParameterValueById === "function") {
				coreModel.setParameterValueById(parameterId, amount, 1);
				return true;
			}

			return false;
		};

		const applyEyeGazeViaParameters = (x, y) => {
			const calibrated = calibrateGaze(x, y);
			addCoreModelParameter("ParamEyeBallX", calibrated.x * gazeConfig.eyeBallX);
			addCoreModelParameter("ParamEyeBallY", calibrated.y * gazeConfig.eyeBallY);
		};

		const applyPoseViaParameters = (x, y) => {
			const calibrated = calibrateGaze(x, y);
			addCoreModelParameter("ParamAngleX", calibrated.x * gazeConfig.angleX);
			addCoreModelParameter("ParamAngleY", calibrated.y * gazeConfig.angleY);
			addCoreModelParameter("ParamAngleZ", calibrated.x * calibrated.y * gazeConfig.angleZ);
			addCoreModelParameter("ParamBodyAngleX", calibrated.x * gazeConfig.bodyAngleX);
			addCoreModelParameter("ParamBodyAngleY", calibrated.y * gazeConfig.bodyAngleY);
		};

		const applyGaze = (x, y) => {
			// This model responds more predictably to direct parameter control
			// than the runtime focus controller, so keep gaze mapping explicit.
			applyEyeGazeViaParameters(x, y);
			applyPoseViaParameters(x, y);
		};

		const deferIdleGaze = (timestamp = performance.now()) => {
			state.gazeIdleTargetX = 0;
			state.gazeIdleTargetY = 0;
			state.gazeIdleNextAt = timestamp + gazeConfig.idleDelayMs;
		};

		const scheduleIdleGaze = (timestamp = performance.now()) => {
			state.gazeIdleNextAt =
				timestamp + randomBetween(gazeConfig.idleHoldMinMs, gazeConfig.idleHoldMaxMs);

			if (Math.random() < 0.25) {
				state.gazeIdleTargetX = 0;
				state.gazeIdleTargetY = 0;
				return;
			}

			state.gazeIdleTargetX = randomBetween(-gazeConfig.idleRangeX, gazeConfig.idleRangeX);
			state.gazeIdleTargetY = randomBetween(-gazeConfig.idleRangeY, gazeConfig.idleRangeY);
		};

		const setGazeTargetFromPoint = (clientX, clientY) => {
			const rect = panel.getBoundingClientRect();
			const focusX = rect.left + rect.width * gazeConfig.faceCenterX;
			const focusY = rect.top + rect.height * gazeConfig.faceCenterY;
			const nearZoneX = (clientX - focusX) / Math.max(rect.width * gazeConfig.nearCancelRangeX, 1);
			const nearZoneY = (clientY - focusY) / Math.max(
				rect.height * gazeConfig.nearCancelRangeY,
				1,
			);
			if (Math.hypot(nearZoneX, nearZoneY) < 1) {
				state.gazePointerActive = false;
				state.gazeTargetX = 0;
				state.gazeTargetY = 0;
				deferIdleGaze();
				return false;
			}

			const rangeX = Math.max(
				rect.width * gazeConfig.pointerRangeX,
				window.innerWidth * gazeConfig.minViewportRangeX,
			);
			const rangeY = Math.max(
				rect.height * gazeConfig.pointerRangeY,
				window.innerHeight * gazeConfig.minViewportRangeY,
			);
			const nextX = (clientX - focusX) / rangeX;
			const nextY = (focusY - clientY) / rangeY;
			const target = clampGazeVector(nextX, nextY);

			state.gazePointerActive = true;
			state.gazeTargetX = target.x;
			state.gazeTargetY = target.y;
			return true;
		};

		const refreshGazeFromLastPointer = () => {
			if (!state.hasMousePosition || root.hidden) {
				return false;
			}

			return setGazeTargetFromPoint(state.lastMouseX, state.lastMouseY);
		};

		const resetGazeTarget = (preservePointer = false) => {
			state.gazePointerActive = false;
			state.gazeTargetX = 0;
			state.gazeTargetY = 0;
			if (!preservePointer) {
				state.hasMousePosition = false;
			}
			deferIdleGaze();
		};

		const updateGazeTarget = (event) => {
			if (!(event instanceof PointerEvent) || event.pointerType !== "mouse" || root.hidden) {
				return;
			}

			const now = performance.now();
			state.lastPointerMoveAt = now;
			state.lastMouseX = event.clientX;
			state.lastMouseY = event.clientY;
			state.hasMousePosition = true;
			setGazeTargetFromPoint(event.clientX, event.clientY);
		};

		const handlePointerExit = (event) => {
			if (!(event instanceof PointerEvent) || event.pointerType !== "mouse") {
				return;
			}

			if (event.relatedTarget !== null) {
				return;
			}

			resetGazeTarget();
		};

		const tickGaze = () => {
			if (!state.model) {
				return;
			}

			const now = performance.now();
			const frameDt =
				state.lastGazeTickAt > 0 ? Math.max(0, now - state.lastGazeTickAt) : 0;
			state.lastGazeTickAt = now;

			const canAnimateGaze =
				!root.hidden &&
				document.visibilityState === "visible" &&
				state.dragPointerId === null;
			let targetX = 0;
			let targetY = 0;
			let smoothing = gazeConfig.returnSpeed;
			let headBobOffsetY = 0;

			if (canAnimateGaze) {
				if (state.gazePointerActive) {
					targetX = state.gazeTargetX;
					targetY = state.gazeTargetY;
					smoothing = gazeConfig.smoothing;
					const followStrength = clamp(
						Math.hypot(state.gazeTargetX, state.gazeTargetY),
						0.24,
						1,
					);
					headBobOffsetY =
						Math.sin(performance.now() * gazeConfig.headBobSpeed) *
						gazeConfig.headBobAmplitudeY *
						followStrength;
				} else {
					const timestamp = performance.now();
					if (state.gazeIdleNextAt <= 0) {
						deferIdleGaze(timestamp);
					}
					if (timestamp >= state.gazeIdleNextAt) {
						scheduleIdleGaze(timestamp);
					}
					targetX = state.gazeIdleTargetX;
					targetY = state.gazeIdleTargetY;
					smoothing = gazeConfig.idleSmoothing;
				}
			}

			state.gazeCurrentX = lerp(state.gazeCurrentX, targetX, smoothing);
			state.gazeCurrentY = lerp(state.gazeCurrentY, targetY, smoothing);

			if (Math.abs(state.gazeCurrentX) < 0.001 && targetX === 0) {
				state.gazeCurrentX = 0;
			}
			if (Math.abs(state.gazeCurrentY) < 0.001 && targetY === 0) {
				state.gazeCurrentY = 0;
			}

			const headPoseAngles = getHeadPoseAngles(state.gazeCurrentX, state.gazeCurrentY);
			const isMouseDrivingHead =
				canAnimateGaze &&
				state.gazePointerActive &&
				state.hasMousePosition &&
				now - state.lastPointerMoveAt <= gazeConfig.dizzinessRecentWindowMs;
			updateDizzinessScore(headPoseAngles.x, headPoseAngles.y, frameDt, isMouseDrivingHead);

			if (state.dizzinessScore >= gazeConfig.dizzinessEnterThreshold) {
				enterFastPointerExpressionMode();
			} else if (
				state.expressionMode === "special" &&
				state.dizzinessScore <= gazeConfig.dizzinessExitThreshold
			) {
				exitFastPointerExpressionMode();
			}

			applyGaze(
				state.gazeCurrentX,
				clamp(state.gazeCurrentY + headBobOffsetY, -1, 1),
			);
		};

		const ensureGazeTicker = () => {
			if (!state.app || state.gazeTickerBound) {
				return;
			}

			state.app.ticker.add(tickGaze);
			state.gazeTickerBound = true;
		};

		const updatePlacementForViewport = () => {
			if (state.locked) {
				applyLockedPlacement();
				return;
			}

			if (!state.position) {
				restorePlacement();
				return;
			}

			const nextPosition = clampPosition(state.position.x, state.position.y);
			applyPosition(nextPosition.x, nextPosition.y);
			persistPlacement();
		};

		const persistVisibility = (hidden) => {
			try {
				localStorage.setItem(visibilityStorageKey, hidden ? "true" : "false");
			} catch (_error) {
				// Ignore storage failures.
			}
		};

		const setHiddenState = (hidden, shouldPersist = true) => {
			root.hidden = hidden;
			root.setAttribute("aria-hidden", hidden ? "true" : "false");
			document.documentElement.dataset.mascotHidden = hidden ? "true" : "false";

			if (hidden) {
				resetGazeTarget();
			}

			if (shouldPersist) {
				persistVisibility(hidden);
			}

			if (!hidden) {
				window.requestAnimationFrame(() => {
					fitModel();
					updatePlacementForViewport();
					if (!refreshGazeFromLastPointer()) {
						resetGazeTarget(true);
					}
				});
			}
		};

		const playExpression = async (expressionName) => {
			if (!state.model || !expressionName) {
				return false;
			}

			const requestId = ++state.expressionRequestId;
			const expressionManager =
				state.model.internalModel?.motionManager?.expressionManager;
			let played = false;

			if (typeof expressionManager?.setExpression === "function") {
				played = await expressionManager.setExpression(expressionName);
			} else if (typeof state.model.expression === "function") {
				played = await state.model.expression(expressionName);
			}

			if (played && requestId === state.expressionRequestId) {
				state.currentExpression = expressionName;
			}

			return played;
		};

		const scheduleNormalExpressionTimer = (delayMs = normalExpressionIntervalMs) => {
			clearModeTimer("normal");
			if (normalExpressionNames.length === 0) {
				return;
			}

			state.normalExpressionTimerRemainingMs = delayMs;
			state.normalExpressionTimerStartedAt = performance.now();
			state.normalExpressionTimer = window.setTimeout(async () => {
				const nextExpression = pickRandomExpression(normalExpressionNames, [
					state.lastNormalExpression,
				]);
				if (await playExpression(nextExpression)) {
					state.lastNormalExpression = nextExpression;
					state.expressionMode = "normal";
				}
				scheduleNormalExpressionTimer(normalExpressionIntervalMs);
			}, delayMs);
		};

		const scheduleInteractiveExpressionTimer = (
			delayMs = interactiveExpressionDurationMs,
		) => {
			clearModeTimer("interactive");
			state.interactiveExpressionTimerRemainingMs = delayMs;
			state.interactiveExpressionTimerStartedAt = performance.now();
			state.interactiveExpressionTimer = window.setTimeout(() => {
				enterNormalExpressionMode(true);
			}, delayMs);
		};

		const enterNormalExpressionMode = (
			shouldRefreshExpression = true,
			delayMs = normalExpressionIntervalMs,
		) => {
			clearModeTimer("interactive");
			state.expressionMode = "normal";

			if (shouldRefreshExpression) {
				const nextExpression = pickRandomExpression(normalExpressionNames, [
					state.lastNormalExpression,
				]);
				void playExpression(nextExpression).then((played) => {
					if (played) {
						state.lastNormalExpression = nextExpression;
					}
				});
			}

			scheduleNormalExpressionTimer(delayMs);
		};

		const resumePausedExpressionMode = () => {
			const pausedMode = state.pausedExpressionMode;
			const pausedExpressionName = state.pausedExpressionName;
			const pausedRemainingMs = Math.max(0, state.pausedExpressionTimerRemainingMs || 0);

			state.pausedExpressionMode = "";
			state.pausedExpressionName = "";
			state.pausedExpressionTimerRemainingMs = 0;

			if (pausedMode !== "normal" && pausedMode !== "interactive") {
				enterNormalExpressionMode(true, normalExpressionIntervalMs);
				return;
			}

			state.expressionMode = pausedMode;
			if (pausedExpressionName) {
				void playExpression(pausedExpressionName);
			}

			const nextDelay = pausedRemainingMs > 0 ? pausedRemainingMs : getModeDuration(pausedMode);
			if (pausedMode === "interactive") {
				scheduleInteractiveExpressionTimer(nextDelay);
				return;
			}

			scheduleNormalExpressionTimer(nextDelay);
		};

		const enterFastPointerExpressionMode = () => {
			if (state.expressionMode === "special") {
				return;
			}

			pauseCurrentExpressionMode();
			state.expressionMode = "special";
			void playExpression(fastPointerExpressionName);
		};

		const exitFastPointerExpressionMode = () => {
			if (state.expressionMode !== "special") {
				return;
			}

			resumePausedExpressionMode();
		};

		const triggerInteractiveExpression = async () => {
			if (interactiveExpressionNames.length === 0) {
				return false;
			}

			if (
				state.expressionMode === "special" ||
				state.dizzinessScore >= gazeConfig.dizzinessEnterThreshold
			) {
				return false;
			}

			const nextExpression = pickRandomExpression(interactiveExpressionNames, [
				state.lastInteractiveExpression,
			]);
			clearModeTimer("normal");
			clearModeTimer("interactive");
			state.pausedExpressionMode = "";
			state.pausedExpressionName = "";
			state.pausedExpressionTimerRemainingMs = 0;
			state.expressionMode = "interactive";
			const played = await playExpression(nextExpression);
			if (!played) {
				return false;
			}
			state.lastInteractiveExpression = nextExpression;
			scheduleInteractiveExpressionTimer(interactiveExpressionDurationMs);
			return true;
		};

		const isPointInsideRect = (x, y, rect) =>
			x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;

		const handOffToMusicControl = (event) => {
			const musicLaunchButton = document.getElementById(
				"background-music-drawer-toggle",
			);
			if (!(musicLaunchButton instanceof HTMLButtonElement)) {
				return false;
			}

			const rect = musicLaunchButton.getBoundingClientRect();
			if (!isPointInsideRect(event.clientX, event.clientY, rect)) {
				return false;
			}

			event.preventDefault();
			event.stopPropagation();
			musicLaunchButton.click();
			return true;
		};

		const beginDrag = (event) => {
			if (!(event instanceof PointerEvent)) {
				return;
			}

			if (handOffToMusicControl(event)) {
				return;
			}

			state.dragPointerId = event.pointerId;
			state.dragStartX = event.clientX;
			state.dragStartY = event.clientY;
			state.dragOriginX = state.position?.x || 0;
			state.dragOriginY = state.position?.y || 0;
			state.dragMoved = false;
			resetGazeTarget(true);
			canvas.setPointerCapture?.(event.pointerId);
		};

		const handleDragMove = (event) => {
			if (!(event instanceof PointerEvent) || state.dragPointerId !== event.pointerId) {
				return;
			}

			if (state.locked) {
				return;
			}

			const deltaX = event.clientX - state.dragStartX;
			const deltaY = event.clientY - state.dragStartY;
			if (Math.abs(deltaX) > 4 || Math.abs(deltaY) > 4) {
				state.dragMoved = true;
			}

			applyPosition(state.dragOriginX + deltaX, state.dragOriginY + deltaY);
		};

		const endDrag = (event) => {
			if (!(event instanceof PointerEvent) || state.dragPointerId !== event.pointerId) {
				return;
			}

			canvas.releasePointerCapture?.(event.pointerId);
			const wasDrag = state.dragMoved;
			state.dragPointerId = null;
			refreshGazeFromLastPointer();

			if (wasDrag) {
				persistPlacement();
				return;
			}

			void triggerInteractiveExpression();
		};

		const initMascot = async () => {
			if (state.initPromise) {
				return state.initPromise;
			}

			state.initPromise = (async () => {
				setStatus("看板娘加载中");

				await ensureScript(pixiUrl, () => Boolean(window.PIXI?.Application));
				await ensureCubismCore();
				await ensureScript(
					live2dUrl,
					() => Boolean(window.PIXI?.live2d?.Live2DModel),
				);

				if (!state.app) {
					state.app = new window.PIXI.Application({
						view: canvas,
						autoStart: true,
						autoDensity: true,
						antialias: true,
						backgroundAlpha: 0,
						width: Math.max(panel.clientWidth, 1),
						height: Math.max(panel.clientHeight, 1),
						resolution: Math.min(window.devicePixelRatio || 1, 2),
					});
				}

				if (!state.model) {
					state.model = await window.PIXI.live2d.Live2DModel.from(modelPath, {
						autoInteract: false,
						idleMotionGroup: "",
					});
					state.baseSize = {
						width: state.model.width,
						height: state.model.height,
					};
					state.app.stage.addChild(state.model);
				}

				fitModel();
				restorePlacement();
				ensureGazeTicker();
				enterNormalExpressionMode(true);
				setStatus("");
			})().catch((error) => {
				state.initPromise = null;
				console.error("Live2D mascot failed to initialize", error);
				setStatus("看板娘加载失败", "error");
				throw error;
			});

			return state.initPromise;
		};

		const handleViewportResize = () => {
			fitModel();
			updatePlacementForViewport();
			if (!refreshGazeFromLastPointer()) {
				resetGazeTarget();
			}
		};

		window.addEventListener("resize", handleViewportResize);
		window.addEventListener("pointermove", updateGazeTarget, { passive: true });
		window.addEventListener("pointerout", handlePointerExit, { passive: true });
		window.addEventListener("blur", resetGazeTarget);
		window.addEventListener("alf:live2d-resize", handleViewportResize);
		window.addEventListener("alf:live2d-lock", (event) => {
			const locked = Boolean(event?.detail?.locked);
			setLockedState(locked, false);
		});
		window.addEventListener("alf:live2d-visibility", (event) => {
			const hidden = Boolean(event?.detail?.hidden);
			setHiddenState(hidden, false);

			if (!hidden) {
				void initMascot();
			}
		});
		canvas.addEventListener("pointerdown", beginDrag);
		canvas.addEventListener("pointermove", handleDragMove);
		canvas.addEventListener("pointerup", endDrag);
		canvas.addEventListener("pointercancel", endDrag);
		canvas.addEventListener("lostpointercapture", () => {
			state.dragPointerId = null;
		});
		document.addEventListener("visibilitychange", () => {
			if (document.visibilityState !== "visible") {
				resetGazeTarget();
			}
		});

		const initiallyHidden = (() => {
			try {
				const rememberedVisibility = localStorage.getItem(visibilityStorageKey);
				if (rememberedVisibility === "true") {
					return true;
				}
				if (rememberedVisibility === "false") {
					return false;
				}
			} catch (_error) {
				// Ignore storage failures.
			}

			return document.documentElement.dataset.mascotHidden === "true";
		})();

		const initiallyLocked = (() => {
			try {
				const rememberedLocked = localStorage.getItem(lockStorageKey);
				if (rememberedLocked === "true") {
					return true;
				}
				if (rememberedLocked === "false") {
					return false;
				}
			} catch (_error) {
				// Ignore storage failures.
			}

			return document.documentElement.dataset.mascotLocked === "true";
		})();

		setLockedState(initiallyLocked, false);
		setHiddenState(initiallyHidden, false);
		resetGazeTarget();
		if (!initiallyHidden) {
			void initMascot();
		}
	})();
</script>
